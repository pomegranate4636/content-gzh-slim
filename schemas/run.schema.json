{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-gzh-slim.invalid/schemas/run.schema.json",
  "title": "ContentGzhSlimRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "input_digest",
    "knowledge_base_identity",
    "ip_identity",
    "task_input",
    "status",
    "status_history",
    "gate_approvals",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{24}$"},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "knowledge_base_identity": {"$ref": "knowledge_base_ref.schema.json"},
    "ip_identity": {"$ref": "ip_ref.schema.json"},
    "task_input": {"$ref": "task_input.schema.json"},
    "status": {
      "enum": [
        "created",
        "direction_working",
        "waiting_direction",
        "direction_approved",
        "context_ready",
        "draft_working",
        "waiting_final",
        "final_approved",
        "saving",
        "saved",
        "distribution_optional",
        "abandoned",
        "blocked"
      ]
    },
    "status_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "at"],
        "properties": {
          "status": {"type": "string"},
          "at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "gate_approvals": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "decision", "at"],
        "properties": {
          "gate": {"enum": ["A", "B"]},
          "decision": {"enum": ["确认方向", "确认正文和标题"]},
          "at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
